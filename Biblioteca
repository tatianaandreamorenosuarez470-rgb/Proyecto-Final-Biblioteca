import json
import uuid
from pathlib import Path
from datetime import datetime

ARCHIVO = Path("notas.json")

def guardar(notas): 
    with open(ARCHIVO,"w",encoding="utf-8") as f:
        json.dump(notas,f, indent=2, ensure_ascii=False)

def leer():
    if not ARCHIVO.exists():
        return []
    texto = ARCHIVO.read_text(encoding="utf-8")
    if texto.strip() == "":
        return []
    return json.loads(texto)

def crear(titulo, contenido, tipo="nota"):
    lista = leer()
    nota = {
        "id": str(uuid.uuid4()),
        "titulo": titulo,
        "contenido": contenido,
        "tipo": tipo,
        "fecha": datetime.now().isoformat(),
    }
    lista.append(nota)
    guardar(lista)
    return nota

if __name__ == "__main__":
    crear("Mi primera nota", "saquen a tatiana")
    print(leer())