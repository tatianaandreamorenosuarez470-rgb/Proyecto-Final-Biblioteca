import json
import uuid
from pathlib import Path
from datetime import datetime
ARCHIVO = Path("bibliotecaDusu.json")
def guardarC(notas): 
    with open(ARCHIVO,"w",encoding="utf-8") as f:
        json.dump(notas,f, indent=2, ensure_ascii=False)
def leer():
    if not ARCHIVO.exists():
        return []
    texto = ARCHIVO.read_text(encoding="utf-8")
    if texto == "":
        return []
    return json.loads(texto)
def crear(titulo, contenido, tipo="notitaalmargen"):
    lista = leer()
    nota = {
        "id": str(uuid.uuid4()),
        "titulo": titulo,
        "contenido": contenido,
        "tipo": tipo,
        "fecha": datetime.now().isoformat(),
    }
    lista.append(nota)
    guardarC(lista)
    return nota
def obtener(id_nota):
    lista = leer()
    for nota in lista:
        if nota["id"] == id_nota:
            return nota
    return None
def listar():
    return leer()
def eliminar(id_nota):
    lista = leer()
    for nota in lista:
        if nota["id"] == id_nota:
            lista.remove(nota)
            guardar(lista)
            return True

    return False
